# Server
PORT=5000
NODE_ENV=production

# MongoDB — use MongoDB Atlas connection string in production
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# WhatsApp (Green API) — get from green-api.com
WHATSAPP_PROVIDER=mock
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_MOCK_MODE=true
